{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "patioping-ingest",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // 09:15 UTC = 4:15 AM Central / 2:15 AM Arizona: after portals refresh overnight,
  // well before the 7 AM alerts. The hourly cron sends each org's alert at its local hour.
  "triggers": { "crons": ["15 9 * * *", "0 * * * *"] },
  "limits": { "cpu_ms": 300000 },
  "observability": { "enabled": true },
  // Daily alerts go out through Cloudflare Email Sending (patioping.com is onboarded).
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "SUPABASE_URL": "https://ofunawvwvunlzbnmkqav.supabase.co",
    "SITE_URL": "https://patioping.com",
    "ALERT_FROM": "alerts@patioping.com",
    "ALERT_FROM_NAME": "PatioPing"
  }
  // Secrets: npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY --config workers/ingest/wrangler.jsonc
  //          npx wrangler secret put SOCRATA_APP_TOKEN        --config workers/ingest/wrangler.jsonc
  //          npx wrangler secret put APIFY_TOKEN              --config workers/ingest/wrangler.jsonc
  //          npx wrangler secret put INGEST_SECRET            --config workers/ingest/wrangler.jsonc
}
