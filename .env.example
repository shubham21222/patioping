NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only (in production: `npx wrangler secret put NAME`)
SUPABASE_SERVICE_ROLE_KEY=

# Whop payments
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_PLAN_STARTER=plan_xxxxxxxxxxxxx
WHOP_PLAN_GROWTH=plan_xxxxxxxxxxxxx
WHOP_PLAN_PRO=plan_xxxxxxxxxxxxx
